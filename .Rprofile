source("renv/activate.R")

# Pin CRAN to a dated Posit Package Manager snapshot for reproducible installs.
# To update packages: change the date, then run renv::update() and renv::snapshot().
options(
  repos = c(
    CRAN = "https://packagemanager.posit.co/cran/2026-10-23",
    rmultiverse = "https://r-multiverse.r-universe.dev",
    rspatial = "https://r-spatial.r-universe.dev"
  )
)
